# Local frontend proxy target. Production requests use the same-origin Vercel rewrite.
VITE_API_URL=http://localhost:8080/api

# Reference only: the backend does not load this file. Configure these values
# in the Render dashboard; replace placeholders there and never commit secrets.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DATABASE_USERNAME=<pooler-username>
DATABASE_PASSWORD=<database-password>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_BUCKET=nexthub-resumes
SUPABASE_SERVICE_ROLE_KEY=<backend-only-secret>
NEXTHUB_CORS_ALLOWED_ORIGIN=https://<your-vercel-domain>
NEXTHUB_SEED_ENABLED=false
DATABASE_POOL_MAX=5
